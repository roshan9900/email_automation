# HDFC Bank Intelligent Email Processing Configuration

# LLM Provider: Set to 'ollama' for local model execution
LLM_PROVIDER=ollama

# Local Ollama Settings
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=180

# Optional Cloud Providers (fallback)
# GROQ_API_KEY=your_groq_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

